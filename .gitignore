# Owner: 02-engine. Public project ignore list.
# Godot cache / imports (regenerated by `--import`)
.godot/
*.translation
# Local engine binaries, export templates, downloads (tools/engine is per-machine)
/tools/engine/
# Build outputs and previews
/build/
/builds/
/exports/
/BakeryKnights.exe
/BakeryKnights.exe.tmp
*.apk
*.aab
*.idsig
# Signing material and secrets (never commit)
*.keystore
*.jks
*.p12
*.pfx
export_credentials.cfg
.env
.env.*
!.env.example
# Coordination runtime (local only)
coordination/logs/
coordination/launchers/
coordination/.runtime/
# Python caches from art tooling
__pycache__/
*.pyc
# OS / editor noise
*.tmp
.DS_Store
Thumbs.db
.android/
mono_crash.*

# Local render intermediates, stems and diagnostics
/tools/audio/_render/
