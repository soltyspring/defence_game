; Engine configuration file. Owner: 02-engine. See docs/contracts/ENGINE.md.
config_version=5

[application]

config/name="Lane Defence"
config/name_localized={
"en": "Bakery Knights",
"ko": "빵집 기사단"
}
config/description="Bakery Knights: Mold Defense"
config/version="0.1.4"
run/main_scene="res://scenes/gameplay/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/branding/launcher_main_192.png"
run/max_fps=60
config/quit_on_go_back=false
run/low_processor_mode_sleep_usec=16000

[autoload]

Events="*res://src/core/events.gd"
Perf="*res://src/core/perf.gd"
Content="*res://src/core/content.gd"
Atlas="*res://src/core/atlas.gd"
Save="*res://src/core/save.gd"
Services="*res://src/services/services.gd"
Audio="*res://src/audio/audio_manager.gd"
App="*res://src/core/app.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[game]

camera/world_zoom_plus_one=true

[gui]

common/snap_controls_to_pixels=true

[importer_defaults]

texture={
"compress/mode": 0,
"mipmaps/generate": false,
"process/fix_alpha_border": true,
"detect_3d/compress_to": 0
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[editor]

import/use_multiple_threads=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false
environment/defaults/default_clear_color=Color(0.09, 0.1, 0.14, 1)
textures/vram_compression/import_etc2_astc=true
